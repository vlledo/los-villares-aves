---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ABUNDANCIA_LABEL } from '../utils/formato';

interface Props {
	aves: CollectionEntry<'aves'>[];
}

const { aves } = Astro.props;
---

<section data-carrusel class="relative">
	<div
		data-carrusel-track
		class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:thin]"
	>
		{
			aves.map((ave) => (
				<a
					href={`/aves/${ave.id}/`}
					class="group relative block w-[85%] shrink-0 snap-start overflow-hidden rounded-xl border border-tierra-200 bg-white no-underline shadow-sm sm:w-[60%] lg:w-[32%]"
				>
					{ave.data.foto_principal && (
						<Image
							src={ave.data.foto_principal}
							alt={`Foto de ${ave.data.nombre_comun}`}
							width={900}
							height={600}
							class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105"
						/>
					)}
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-tierra-900/85 via-tierra-900/40 to-transparent p-4 text-white">
						<div class="text-[11px] uppercase tracking-wider text-tierra-100/90">
							{ABUNDANCIA_LABEL[ave.data.abundancia]}
						</div>
						<h3 class="mt-0.5 text-xl font-bold text-white">
							{ave.data.nombre_comun}
						</h3>
						<p class="text-sm italic text-tierra-100/80">
							{ave.data.nombre_cientifico}
						</p>
					</div>
				</a>
			))
		}
	</div>

	<button
		type="button"
		data-carrusel-prev
		aria-label="Anterior"
		class="absolute left-2 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-tierra-200 bg-white/90 text-tierra-800 shadow-md backdrop-blur transition hover:bg-white hover:text-olivo-700 sm:flex"
	>
		<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<path d="M13 16l-6-6 6-6" />
		</svg>
	</button>
	<button
		type="button"
		data-carrusel-next
		aria-label="Siguiente"
		class="absolute right-2 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-tierra-200 bg-white/90 text-tierra-800 shadow-md backdrop-blur transition hover:bg-white hover:text-olivo-700 sm:flex"
	>
		<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<path d="M7 4l6 6-6 6" />
		</svg>
	</button>
</section>

<script>
	const carrusel = document.querySelector<HTMLElement>('[data-carrusel]');
	if (carrusel) {
		const track = carrusel.querySelector<HTMLElement>('[data-carrusel-track]');
		const prev = carrusel.querySelector<HTMLElement>('[data-carrusel-prev]');
		const next = carrusel.querySelector<HTMLElement>('[data-carrusel-next]');

		const desplazar = (direction: 1 | -1) => {
			if (!track) return;
			const card = track.querySelector<HTMLElement>(':scope > a');
			const gap = parseFloat(getComputedStyle(track).columnGap || '16');
			const step = (card?.offsetWidth ?? 320) + gap;
			track.scrollBy({ left: step * direction, behavior: 'smooth' });
		};

		prev?.addEventListener('click', () => desplazar(-1));
		next?.addEventListener('click', () => desplazar(1));
	}
</script>
