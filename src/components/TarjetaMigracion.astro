---
import { Image } from 'astro:assets';
import { meses } from '../content.config';
import type { Grupo } from '../utils/migraciones-logica';
import { textoKm, textoRango } from '../utils/migraciones-logica';
import type { Migrante } from '../utils/migraciones';
import { MES_INICIAL, MES_LARGO, PRESENCIA_COLOR, PRESENCIA_LABEL } from '../utils/meses';

interface Props {
	migrante: Migrante;
}

const { ave, migracion: m } = Astro.props.migrante;

const ETIQUETA_GRUPO: Record<Grupo, string> = {
	estival: 'Estival',
	invernante: 'Invernante',
	paso: 'De paso',
};
const ESTILO_GRUPO: Record<Grupo, string> = {
	estival: PRESENCIA_COLOR.estival,
	invernante: PRESENCIA_COLOR.invernante,
	paso: PRESENCIA_COLOR.paso,
};

const verboPrimavera: Record<Grupo, string> = {
	estival: 'Llega',
	invernante: 'Se va',
	paso: 'Pasa',
};
const verboOtono: Record<Grupo, string> = {
	estival: 'Se va',
	invernante: 'Llega',
	paso: 'Pasa',
};

const trayecto =
	m.grupo === 'estival'
		? `Pasa el invierno en ${m.zona_invernada.nombre}`
		: m.grupo === 'invernante'
			? `Cría en ${m.zona_cria.nombre}`
			: `Cría en ${m.zona_cria.nombre} e inverna en ${m.zona_invernada.nombre}`;

const escalas = m.escalas ?? [];
---

<!--
	La tarjeta ocupa 6 filas de la rejilla de la página y las reparte con subgrid: foto,
	cabecera, kilómetros, fechas y meses, "Cómo viaja" y acciones. Así cada sección queda
	a la misma altura en todas las tarjetas de una fila, sea cual sea la longitud de sus textos.
-->
<article
	data-tarjeta-migracion
	data-slug={ave.id}
	data-grupo={m.grupo}
	class="mb-4 grid row-span-6 grid-rows-subgrid gap-y-0 overflow-hidden rounded-xl border border-tierra-200 bg-white transition-shadow data-[seleccionada]:border-olivo-400 data-[seleccionada]:shadow-md"
>
	{
		ave.data.foto_principal ? (
			<Image
				src={ave.data.foto_principal}
				alt={`Foto de ${ave.data.nombre_comun}`}
				width={600}
				height={300}
				class="aspect-[2/1] w-full object-cover"
			/>
		) : (
			<div class="aspect-[2/1] w-full bg-tierra-100"></div>
		)
	}

	<div class="px-4 pt-4">
		<span class:list={['w-fit rounded-full px-2.5 py-0.5 text-xs font-semibold', ESTILO_GRUPO[m.grupo]]}>
			{ETIQUETA_GRUPO[m.grupo]}
		</span>
		<h3 class="mt-2 text-lg font-bold leading-tight text-tierra-900">
			<a href={`/aves/${ave.id}/`} class="no-underline hover:text-olivo-700">{ave.data.nombre_comun}</a>
		</h3>
		<p class="text-xs italic text-tierra-500">{ave.data.nombre_cientifico}</p>
	</div>

	<div class="px-4 pt-3">
		<p class="text-xs font-semibold uppercase tracking-wide text-tierra-500">Recorre</p>
		<p class="text-2xl font-bold leading-tight text-olivo-700">{textoKm(m.km)}</p>
		<p class="mt-1 text-sm text-tierra-700">{trayecto}</p>
	</div>

	<div data-seccion="meses" class="px-4 pt-3">
		<dl class="space-y-1 text-sm text-tierra-700">
			<div data-fecha="primavera" class="flex justify-between gap-2 data-[destacada]:font-semibold data-[destacada]:text-tierra-900">
				<dt>{verboPrimavera[m.grupo]} en primavera</dt>
				<dd>{textoRango(m.primavera)}</dd>
			</div>
			<div data-fecha="otono" class="flex justify-between gap-2 data-[destacada]:font-semibold data-[destacada]:text-tierra-900">
				<dt>{verboOtono[m.grupo]} en otoño</dt>
				<dd>{textoRango(m.otono)}</dd>
			</div>
		</dl>

		<div
			class="mt-3 grid grid-cols-12 gap-px"
			role="img"
			aria-label={`Presencia mensual en Los Villares: ${meses
				.map((mes) => `${MES_LARGO[mes]} ${PRESENCIA_LABEL[ave.data.estacionalidad[mes]].toLowerCase()}`)
				.join(', ')}`}
		>
			{
				meses.map((mes) => (
					<span
						title={`${MES_LARGO[mes]}: ${PRESENCIA_LABEL[ave.data.estacionalidad[mes]]}`}
						class:list={[
							'flex h-5 items-center justify-center text-[9px] font-semibold',
							PRESENCIA_COLOR[ave.data.estacionalidad[mes]],
						]}
					>
						{MES_INICIAL[mes]}
					</span>
				))
			}
		</div>
	</div>

	<div data-seccion="viaje" class="mx-4 mt-4 border-t border-tierra-100 pt-3 text-sm text-tierra-700">
		<p class="text-xs font-semibold uppercase tracking-wide text-tierra-500">Cómo viaja</p>
		<p class="mt-1">
			{m.viaje === 'con_escalas' ? 'Con escalas' : 'Sin paradas largas conocidas'}
		</p>
		{
			escalas.length > 0 && (
				<ul class="mt-1 list-disc space-y-1 pl-5">
					{escalas.map((e) => (
						<li>
							<span class="font-medium">{e.nombre}</span>
							{e.nota && <span> · {e.nota}</span>}
						</li>
					))}
				</ul>
			)
		}
		{m.nota && <p class="mt-2">{m.nota}</p>}
	</div>

	<div class="flex flex-wrap items-end gap-x-4 gap-y-2 px-4 pb-4 pt-4 text-sm">
		<button
			type="button"
			hidden
			data-ver-en-mapa
			aria-pressed="false"
			class="rounded-full border border-tierra-200 bg-tierra-50 px-3 py-1 text-xs text-tierra-700 hover:bg-tierra-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-olivo-600 aria-pressed:border-olivo-300 aria-pressed:bg-olivo-100 aria-pressed:font-semibold aria-pressed:text-olivo-800"
		>
			Ver en el mapa
		</button>
		<a href={`/aves/${ave.id}/`} class="ml-auto font-medium text-olivo-700 no-underline hover:underline">
			Ver ficha →
		</a>
	</div>
</article>
